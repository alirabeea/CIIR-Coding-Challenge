SEARCH_PROVIDER=serpapi
BRAVE_API_KEY=
SERPAPI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
DEFAULT_RUN_MODE=balanced
MAX_SEARCH_RESULTS=8
MAX_PAGES_TO_SCRAPE=6
MAX_CHUNKS_PER_PAGE=2
CHUNK_SIZE_CHARS=4000
CHUNK_OVERLAP_CHARS=400
MAX_ENTITIES_PER_CHUNK=4
MAX_EXTRACTION_COMPLETION_TOKENS=1200
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENCY=5
MAX_PAGE_TEXT_CHARS=12000
MIN_PAGE_TEXT_CHARS=160
MAX_RESULTS_PER_DOMAIN=2
FAST_MAX_ROWS=16
BALANCED_MAX_ROWS=28
DEEP_MAX_ROWS=40
QUERY_CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=900
PAGE_CACHE_TTL_SECONDS=1800
EXTRACTION_CACHE_TTL_SECONDS=1800
PERSISTENT_CACHE_ENABLED=true
PERSISTENT_CACHE_PATH=.cache/agentic-search.sqlite3
STALE_CACHE_ENABLED=true
STALE_CACHE_TTL_SECONDS=21600
SAVE_REPORTS=true
REPORT_DIRECTORY=reports
MAX_SAVED_REPORTS=25
JOB_STORE_DIRECTORY=reports/jobs
MAX_CACHED_QUERIES=24
MAX_CACHED_SEARCHES=48
MAX_CACHED_PAGES=128
MAX_CACHED_EXTRACTIONS=256
HTTP_RETRIES=2
FALLBACK_RESULT_MIN_ROWS=8
FALLBACK_MAX_ROWS=10
VERIFICATION_ENABLED=true
VERIFICATION_MAX_ROWS=4
VERIFICATION_MIN_CONFIDENCE=0.72
GITHUB_ENRICHMENT_ENABLED=true
GITHUB_REQUEST_TIMEOUT_SECONDS=8
JS_RENDER_FALLBACK_ENABLED=false
JS_RENDER_TIMEOUT_SECONDS=18
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
JOB_RETENTION_SECONDS=1800
CIRCUIT_BREAKER_FAILURES=4
CIRCUIT_BREAKER_RESET_SECONDS=60
